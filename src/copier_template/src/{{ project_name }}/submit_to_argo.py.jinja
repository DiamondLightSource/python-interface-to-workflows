import os

import dotenv
from hera.shared import global_config

from {{ project_name }}.auth.keycloak_checker import set_token_env_variable


def prepare_to_submit(staging: bool):
    set_token_env_variable(staging=staging)
    dotenv.load_dotenv(dotenv_path="src/.env", override=True)
    global_config.host = str(os.environ.get("HOST"))
    global_config.image = str(os.environ.get("IMAGE"))
    global_config.token = str(os.environ.get("TOKEN"))
